# Google Analytics 4 Measurement ID. Defaults to the production one if unset
# (see src/lib/analytics.ts).
VITE_GA_MEASUREMENT_ID=G-R0SHPW5E39

# Google AdSense client ID (ca-pub- followed by 16 digits). Empty = no AdSense:
# its tag isn't loaded and consent is handled only by our own banner. With an ID,
# the tag is injected into <head> and Google's CMP ("Privacy & messaging")
# handles consent for visitors in the EEA, UK and Switzerland.
VITE_ADSENSE_CLIENT=
